{
  "branch_protection_rules": {
    "main": {
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "lint (ubuntu-latest, 5.1)",
          "lint (ubuntu-latest, 5.4)",
          "lint (ubuntu-latest, luajit)",
          "lint (macos-latest, 5.1)",
          "lint (macos-latest, 5.4)",
          "lint (macos-latest, luajit)",
          "test (ubuntu-latest, 5.1)",
          "test (ubuntu-latest, 5.4)",
          "test (ubuntu-latest, luajit)",
          "test (macos-latest, 5.1)",
          "test (macos-latest, 5.4)",
          "test (macos-latest, luajit)",
          "security-audit",
          "dependency-audit",
          "type-check",
          "build-verification (ubuntu-latest)",
          "build-verification (macos-latest)",
          "integration-check"
        ]
      },
      "enforce_admins": true,
      "required_pull_request_reviews": {
        "dismiss_stale_reviews": true,
        "require_code_owner_reviews": true,
        "required_approving_review_count": 1
      },
      "restrictions": null,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_linear_history": true
    },
    "develop": {
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "lint (ubuntu-latest, 5.4)",
          "test (ubuntu-latest, 5.4)",
          "security-audit",
          "type-check"
        ]
      },
      "enforce_admins": false,
      "required_pull_request_reviews": {
        "dismiss_stale_reviews": false,
        "require_code_owner_reviews": false,
        "required_approving_review_count": 1
      },
      "restrictions": null,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_linear_history": false
    }
  },
  "notes": {
    "setup_instructions": [
      "1. Go to repository Settings > Branches",
      "2. Add branch protection rule for 'main'",
      "3. Configure required status checks using the contexts listed above",
      "4. Enable 'Require branches to be up to date before merging'",
      "5. Enable 'Restrict pushes that create files larger than 100 MB'",
      "6. Repeat for 'develop' branch with relaxed rules"
    ],
    "security_requirements": [
      "All status checks must pass before merge",
      "No '|| true' allowed on security-critical steps",
      "Warnings treated as errors in all jobs",
      "100% test coverage required",
      "Security audit must pass"
    ]
  }
}