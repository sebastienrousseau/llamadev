# Ollama Environment Configuration
# Optimized for CodeLlama 7B Code Q4_K_M
#
# Copy to ~/.ollama/ollama.env or set as environment variables
# Documentation: https://github.com/ollama/ollama/blob/main/docs/faq.md

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Bind address (0.0.0.0 for container access)
OLLAMA_HOST=0.0.0.0:11434

# Enable debug logging (disable in production)
OLLAMA_DEBUG=false

# Keep model loaded in memory (seconds, 0 = unload immediately, -1 = never unload)
# For 7B model, keep loaded for faster responses
OLLAMA_KEEP_ALIVE=300

# Maximum number of concurrent requests
OLLAMA_NUM_PARALLEL=2

# Maximum number of models to load simultaneously
OLLAMA_MAX_LOADED_MODELS=1

# ============================================================================
# MEMORY & PERFORMANCE
# ============================================================================

# Maximum VRAM to use (in bytes, 0 = automatic)
# For 7B Q4_K_M: ~4.5GB VRAM recommended
# OLLAMA_MAX_VRAM=5000000000

# Number of GPU layers to offload (-1 = all, 0 = CPU only)
# CodeLlama 7B has 32 layers
OLLAMA_GPU_LAYERS=-1

# Flash attention (faster on newer GPUs)
OLLAMA_FLASH_ATTENTION=true

# Use memory mapping for faster model loading
OLLAMA_MMAP=true

# Lock model in memory (prevents swapping, requires permissions)
OLLAMA_MLOCK=false

# ============================================================================
# MODEL DIRECTORIES
# ============================================================================

# Custom model storage directory
# OLLAMA_MODELS=/path/to/models

# ============================================================================
# CUDA/GPU CONFIGURATION (if applicable)
# ============================================================================

# Visible CUDA devices (comma-separated GPU IDs)
# CUDA_VISIBLE_DEVICES=0

# Force specific compute capability
# CUDA_COMPUTE_CAPABILITY=8.6
