#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Test double for `ollama`. Records argv to $STUB_LOG and simulates just enough
# of the subcommands the runtime-hook uses. Steerable via env:
#   STUB_OLLAMA_SERVE_RC   exit code for `serve`   (default 0)
#   STUB_OLLAMA_PULL_RC    exit code for `pull`    (default 0)
#   STUB_OLLAMA_HAS_MODEL  when 1, `list` reports the default model installed
printf 'ollama %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
case "${1:-}" in
  serve) exit "${STUB_OLLAMA_SERVE_RC:-0}" ;;
  list)
    if [ "${STUB_OLLAMA_HAS_MODEL:-0}" = "1" ]; then
      printf '%s\tabc123def456\t4.0 GB\t1 hour ago\n' \
        "${OLLAMA_DEFAULT_MODEL:-qwen2.5-coder}"
    fi
    exit 0 ;;
  pull) exit "${STUB_OLLAMA_PULL_RC:-0}" ;;
  *) exit 0 ;;
esac
