# .env
LANG="C.UTF-8"
NAME="LlamaDev"
OS="linux"
PYTHON_VERSION="3.13.2"
SHELL="/bin/bash"
TZ="UTC"
USER_HOME="/home/llamadev"
USERNAME="llamadev"
VERSION="0.0.2"

# LLM Configuration
# Provider: "ollama" (default) or "lmstudio"
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5-coder"

# Ollama settings (default: http://localhost:11434)
OLLAMA_HOST="http://localhost:11434"

# LM Studio settings (default: http://localhost:1234)
# When using LM Studio, set LLM_PROVIDER="lmstudio" and ensure
# the model file codellama-7b-code-q4_K_M.gguf is loaded
LMSTUDIO_HOST="http://localhost:1234"