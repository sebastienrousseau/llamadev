# llamadev — example environment. Copy to `.env` (which is gitignored AND
# dockerignored) and fill in. NEVER put real secrets in THIS file.
#
# The .env is loaded at RUNTIME only (compose `env_file`). It is never
# committed and never COPY'd into an image layer.

# Image naming (optional).
#IMAGE=llamadev
#TAG=local

# Timezone for the container.
TZ=UTC

# --- Ollama (loopback-only, unauthenticated) ---------------------------------
# Do NOT set this to 0.0.0.0 — the service has no auth and must stay on
# loopback. compose/Makefile already pin it to 127.0.0.1.
#OLLAMA_HOST=127.0.0.1:11434

# Default model the runtime hook targets.
#OLLAMA_DEFAULT_MODEL=qwen2.5-coder

# Pull the default model automatically on first start (multi-GB download).
# 0 = off (default; pull manually with `ollama pull qwen2.5-coder`), 1 = on.
#LLAMADEV_AUTO_PULL=0

# --- Secrets (examples — placeholders only) ----------------------------------
# Provide real values only in your local .env, or via your secret manager.
#SOME_API_TOKEN=replace-me
